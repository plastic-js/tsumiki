{
  "name": "@plastic-js/tsumiki",
  "version": "0.1.70",
  "description": "A UI component library for Plastic JS.",
  "license": "MIT",
  "author": "tigre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plastic-js/tsumiki.git"
  },
  "bugs": {
    "url": "https://github.com/plastic-js/tsumiki/issues"
  },
  "homepage": "https://github.com/plastic-js/tsumiki#readme",
  "keywords": [
    "ui",
    "components",
    "component-library",
    "plastic-js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/tsumiki.css",
    "./tsumiki.css": "./dist/tsumiki.css",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src/styles",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:styles",
    "build:styles": "vite build --config vite.styles.config.js && cp dist-styles/*.css dist/tsumiki.css && rm -rf dist-styles",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "theme": "node scripts/theme.js",
    "e2e:bottomsheet": "node e2e/bottomsheet-presence-verify.mjs",
    "e2e:dialog-portal": "node e2e/dialog-portal-verify.mjs",
    "e2e:bottomsheet-animation": "node e2e/bottomsheet-animation-verify.mjs",
    "e2e:select-rerender": "node e2e/select-rerender-verify.mjs"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@zag-js/focus-trap": "1.40.0",
    "@zag-js/select": "1.40.0",
    "popmotion": "^11.0.5"
  },
  "peerDependencies": {
    "@plastic-js/ark": "^1.0.17",
    "@plastic-js/plastic": "^1.0.23"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@plastic-js/ark": "^1.0.17",
    "@plastic-js/babel-preset-plastic": "^0.1.11",
    "@plastic-js/plastic": "^1.0.23",
    "@radix-ui/colors": "^3.0.0",
    "@zag-js/combobox": "1.40.0",
    "puppeteer-core": "^25.1.0",
    "vite": "^8.0.15"
  }
}
